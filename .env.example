# Porta do servidor Express
PORT=3000

# Conexão com o PostgreSQL.
# Em produção, aponte para o seu Postgres (fora do docker-compose).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contribua

# Porta publicada pelo docker-compose (SOMENTE testes locais).
# Use 5433 se já tiver um Postgres na 5432.
POSTGRES_PORT=5432

# Segredo para assinar os tokens de sessão (troque em produção!)
JWT_SECRET=troque-este-segredo

# production em produção (ativa cookie seguro / secure — requer HTTPS)
NODE_ENV=development

# Tempo máximo (ms) de espera pela resposta do webhook do CRM.
CRM_TIMEOUT_MS=20000
